	measure 'Ninja B' = SELECTEDVALUE('ComparadorB'[personagem_id], 1307)
		displayFolder: Comparador
		lineageTag: a913a743-22e1-5e8c-a477-3aaed81328e7

	measure 'Nome B' = VAR __NinjaId = [Ninja B] RETURN LOOKUPVALUE('personagens'[nome], 'personagens'[personagem_id], __NinjaId)
