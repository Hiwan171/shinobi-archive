		displayFolder: Ficha
		lineageTag: 62c4c413-e0b6-53ab-89d9-9f6d07b51577

	measure 'Chakra da ficha' = VAR __NinjaId = [Ninja ID] RETURN CONCATENATEX(FILTER(ALL('personagem_natureza'), 'personagem_natureza'[personagem_id] = __NinjaId), 'personagem_natureza'[nome_original], "  ·  ")
		displayFolder: Ficha
