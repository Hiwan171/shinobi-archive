	measure 'Técnicas A' = VAR __NinjaId = [Ninja A] RETURN CALCULATE(DISTINCTCOUNT('personagem_jutsu'[jutsu_id]), REMOVEFILTERS('personagens'), TREATAS({__NinjaId}, 'personagem_jutsu'[personagem_id]))
		formatString: #,0
		displayFolder: Comparador
