	measure 'Votos do recorte' = VAR Regiao = SELECTEDVALUE('Regioes'[regiao], "all") RETURN CALCULATE(SUM('votacao_narutop99'[votos]), REMOVEFILTERS('Regioes'), TREATAS({Regiao}, 'votacao_narutop99'[regiao]))
