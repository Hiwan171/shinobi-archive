	measure 'Técnicas B' = VAR __NinjaId = [Ninja B] RETURN CALCULATE(DISTINCTCOUNT('personagem_jutsu'[jutsu_id]), REMOVEFILTERS('personagens'), TREATAS({__NinjaId}, 'personagem_jutsu'[personagem_id]))
		formatString: #,0
		displayFolder: Comparador
		lineageTag: 375d2ef1-86dd-5918-8f89-b24828054a67

	measure 'Naturezas B' = VAR __NinjaId = [Ninja B] RETURN LOOKUPVALUE('personagens'[quantidade_naturezas_listadas], 'personagens'[personagem_id], __NinjaId)
		formatString: #,0
		displayFolder: Comparador
		lineageTag: 5c4ad20c-015b-5c33-ae9d-64b97094377a

	measure 'Técnicas em comum' = VAR IdA = [Ninja A] VAR IdB = [Ninja B] VAR A = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdA), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR B = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdB), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR Comuns = INTERSECT(A, B) RETURN COUNTROWS(Comuns)
		formatString: #,0
		displayFolder: Comparador
		lineageTag: d320bbd8-ce6d-5767-94a0-2f3b01142a3a

	measure 'Técnicas compartilhadas' = VAR IdA = [Ninja A] VAR IdB = [Ninja B] VAR A = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdA), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR B = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdB), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR Comuns = INTERSECT(A, B) RETURN CONCATENATEX(TOPN(12, Comuns, [Tecnica], ASC), LOOKUPVALUE('jutsus'[nome], 'jutsus'[jutsu_id], [Tecnica]), UNICHAR(10))
		displayFolder: Comparador
		lineageTag: 431489eb-49b9-51bb-ac61-640ad457e7ef

	column versao
		dataType: string
		isHidden
		lineageTag: 65da5ba6-dc6f-5f6f-ac67-532040ac4241
		summarizeBy: none
		sourceColumn: versao

	partition Indicadores = m
		mode: import
		source =
				let
				    Dados = Json.Document(Binary.Decompress(Binary.FromText("H4sIAAAAAAACCouuVipLLSpOzFeyUjLUM1CqjQUAbb8HThIAAAA=", BinaryEncoding.Base64), Compression.GZip)),
				    Fonte = Table.FromRecords(Dados),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"versao", type text}}, "en-US")
				in
				    Tipos

