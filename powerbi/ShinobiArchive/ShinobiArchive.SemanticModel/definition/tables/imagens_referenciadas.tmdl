				    Fonte = Table.FromRecords(Dados),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"personagem_id", Int64.Type}, {"ordem", Int64.Type}, {"url", type text}, {"fonte", type text}, {"arquivo_local", type text}, {"status", type text}}, "en-US")
				in
