table InterfaceHTML
	isHidden
	lineageTag: cafaa5dd-bee0-509a-813e-f89c75a30aba

	column ordem
		dataType: int64
		formatString: #,0
		lineageTag: 0062b178-43c8-51f2-bdb3-a8403c4fdfdd
		summarizeBy: none
		sourceColumn: ordem

	column conteudo
		dataType: string
		lineageTag: 6a6f714c-6364-5b0f-b5f4-1afe6f7d6f08
		summarizeBy: none
		sourceColumn: conteudo

	partition InterfaceHTML = m
		mode: import
		source =
				let
				    Dados = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				    Fonte = Table.FromRecords(Dados),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"ordem", Int64.Type}, {"conteudo", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

