	partition vilas = m
		mode: import
		source =
				let
				    Dados = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				    Fonte = Table.FromRecords(Dados),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"vila_id", Int64.Type}, {"nome", type text}, {"fonte", type text}}, "en-US")
				in
				    Tipos

