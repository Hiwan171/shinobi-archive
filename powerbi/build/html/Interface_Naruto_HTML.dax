VAR __JsontechniqueDetails = "[" & CONCATENATEX(FILTER(ALLSELECTED('TecnicasCuradas'), NOT ISBLANK('TecnicasCuradas'[jutsu_id])), "[" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[jutsu_id], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[nome_pt], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[categoria], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[animacao], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[descricao], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[url_fonte], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('TecnicasCuradas'[tipo_midia], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "]", ",") & "]"
VAR __Dataset = "{" & """characters"":{""fields"":[""id"",""name"",""clan"",""village"",""classification"",""sex"",""birthday"",""blood"",""portrait"",""rank"",""votes""],""rows"":" & __Jsoncharacters & "}" & "," & """clans"":{""fields"":[""id"",""name""],""rows"":" & __Jsonclans & "}" & "," & """villages"":{""fields"":[""id"",""name""],""rows"":" & __Jsonvillages & "}" & "," & """teams"":{""fields"":[""id"",""name""],""rows"":" & __Jsonteams & "}" & "," & """clanLinks"":{""fields"":[""person"",""group""],""rows"":" & __JsonclanLinks & "}" & "," & """villageLinks"":{""fields"":[""person"",""group""],""rows"":" & __JsonvillageLinks & "}" & "," & """jutsus"":{""fields"":[""id"",""name""],""rows"":" & __Jsonjutsus & "}" & "," & """techniques"":{""fields"":[""person"",""technique""],""rows"":" & __Jsontechniques & "}" & "," & """chakra"":{""fields"":[""person"",""name""],""rows"":" & __Jsonchakra & "}" & "," & """family"":{""fields"":[""person"",""kinship"",""name"",""related""],""rows"":" & __Jsonfamily & "}" & "," & """physical"":{""fields"":[""person"",""attribute"",""phase"",""value""],""rows"":" & __Jsonphysical & "}" & "," & """grades"":{""fields"":[""person"",""phase"",""grade""],""rows"":" & __Jsongrades & "}" & "," & """official"":{""fields"":[""id"",""person"",""name""],""rows"":" & __Jsonofficial & "}" & "," & """votes"":{""fields"":[""official"",""person"",""region"",""rank"",""votes""],""rows"":" & __Jsonvotes & "}" & "," & """arcs"":{""fields"":[""id"",""series"",""name"",""first"",""last""],""rows"":" & __Jsonarcs & "}" & "," & """episodes"":{""fields"":[""id"",""series"",""number"",""title"",""kind"",""arc""],""rows"":" & __Jsonepisodes & "}" & "," & """profiles"":{""fields"":[""person"",""native"",""source""],""rows"":" & __Jsonprofiles & "}" & "," & """teamLinks"":{""fields"":[""person"",""team""],""rows"":" & __JsonteamLinks & "}" & "," & """inherited"":{""fields"":[""id"",""name""],""rows"":" & __Jsoninherited & "}" & "," & """inheritedLinks"":{""fields"":[""person"",""ability""],""rows"":" & __JsoninheritedLinks & "}" & "," & """debuts"":{""fields"":[""person"",""medium"",""reference""],""rows"":" & __Jsondebuts & "}" & "," & """biographies"":{""fields"":[""person"",""title"",""intro"",""style"",""sources"",""type""],""rows"":" & __Jsonbiographies & "}" & "," & """history"":{""fields"":[""person"",""order"",""phase"",""title"",""text"",""spoiler"",""source""],""rows"":" & __Jsonhistory & "}" & "," & """techniqueDetails"":{""fields"":[""id"",""name"",""category"",""animation"",""description"",""source"",""mediaType""],""rows"":" & __JsontechniqueDetails & "}" & "}"
VAR __Html = CONCATENATEX(ALL('InterfaceHTML'), MID('InterfaceHTML'[conteudo], 2, LEN('InterfaceHTML'[conteudo])-2), "", 'InterfaceHTML'[ordem], ASC)
RETURN SUBSTITUTE(__Html, "__NARUTO_DATA__", SUBSTITUTE(__Dataset, "<", "\u003c"))