	measure 'Técnicas compartilhadas' = VAR IdA = [Ninja A] VAR IdB = [Ninja B] VAR A = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdA), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR B = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdB), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR Comuns = INTERSECT(A, B) RETURN CONCATENATEX(TOPN(12, Comuns, [Tecnica], ASC), LOOKUPVALUE('jutsus'[nome], 'jutsus'[jutsu_id], [Tecnica]), UNICHAR(10))
		displayFolder: Comparador
		lineageTag: 431489eb-49b9-51bb-ac61-640ad457e7ef

	/// Interface completa em HTML/CSS/JS; JSON serializado das tabelas do modelo no contexto recebido pelo visual.
	measure 'Interface Naruto HTML' =
			VAR __Jsoncharacters = "[" & CONCATENATEX(FILTER(ALLSELECTED('personagens'), NOT ISBLANK('personagens'[personagem_id])), "[" & IF(ISBLANK('personagens'[personagem_id]), "null", FORMAT('personagens'[personagem_id], "0", "en-US")) & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[nome], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[cla_exibicao], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[vila_principal], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[classificacao_resumo], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[sexo_pt], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[aniversario_original], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[tipo_sanguineo], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagens'[retrato_url], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & IF(ISBLANK('personagens'[posicao_narutop99]), "null", FORMAT('personagens'[posicao_narutop99], "0", "en-US")) & "," & IF(ISBLANK('personagens'[votos_narutop99]), "null", FORMAT('personagens'[votos_narutop99], "0", "en-US")) & "]", ",") & "]"
			VAR __Jsonclans = "[" & CONCATENATEX(FILTER(ALLSELECTED('clas'), NOT ISBLANK('clas'[cla_id])), "[" & IF(ISBLANK('clas'[cla_id]), "null", FORMAT('clas'[cla_id], "0", "en-US")) & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('clas'[nome], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "]", ",") & "]"
			VAR __Jsonvillages = "[" & CONCATENATEX(FILTER(ALLSELECTED('vilas'), NOT ISBLANK('vilas'[vila_id])), "[" & IF(ISBLANK('vilas'[vila_id]), "null", FORMAT('vilas'[vila_id], "0", "en-US")) & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('vilas'[nome], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "]", ",") & "]"
			VAR __Jsonteams = "[" & CONCATENATEX(FILTER(ALLSELECTED('equipes'), NOT ISBLANK('equipes'[equipe_id])), "[" & IF(ISBLANK('equipes'[equipe_id]), "null", FORMAT('equipes'[equipe_id], "0", "en-US")) & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('equipes'[nome], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "]", ",") & "]"
			VAR __JsonclanLinks = "[" & CONCATENATEX(FILTER(ALLSELECTED('personagem_clas'), NOT ISBLANK('personagem_clas'[personagem_id])), "[" & IF(ISBLANK('personagem_clas'[personagem_id]), "null", FORMAT('personagem_clas'[personagem_id], "0", "en-US")) & "," & IF(ISBLANK('personagem_clas'[cla_id]), "null", FORMAT('personagem_clas'[cla_id], "0", "en-US")) & "]", ",") & "]"
			VAR __JsonvillageLinks = "[" & CONCATENATEX(FILTER(ALLSELECTED('personagem_vilas'), NOT ISBLANK('personagem_vilas'[personagem_id])), "[" & IF(ISBLANK('personagem_vilas'[personagem_id]), "null", FORMAT('personagem_vilas'[personagem_id], "0", "en-US")) & "," & IF(ISBLANK('personagem_vilas'[vila_id]), "null", FORMAT('personagem_vilas'[vila_id], "0", "en-US")) & "]", ",") & "]"
			VAR __Jsonjutsus = "[" & CONCATENATEX(FILTER(ALLSELECTED('jutsus'), NOT ISBLANK('jutsus'[jutsu_id])), "[" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('jutsus'[jutsu_id], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('jutsus'[nome], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "]", ",") & "]"
			VAR __Jsontechniques = "[" & CONCATENATEX(FILTER(ALLSELECTED('personagem_jutsu'), NOT ISBLANK('personagem_jutsu'[personagem_id])), "[" & IF(ISBLANK('personagem_jutsu'[personagem_id]), "null", FORMAT('personagem_jutsu'[personagem_id], "0", "en-US")) & "," & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE('personagem_jutsu'[jutsu_id], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "]", ",") & "]"
