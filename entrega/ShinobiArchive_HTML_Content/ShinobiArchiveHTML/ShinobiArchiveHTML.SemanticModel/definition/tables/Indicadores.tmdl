	measure 'Técnicas em comum' = VAR IdA = [Ninja A] VAR IdB = [Ninja B] VAR A = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdA), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR B = DISTINCT(SELECTCOLUMNS(FILTER(ALL('personagem_jutsu'), 'personagem_jutsu'[personagem_id] = IdB), "Tecnica", 'personagem_jutsu'[jutsu_id])) VAR Comuns = INTERSECT(A, B) RETURN COUNTROWS(Comuns)
