			VAR __Html = CONCATENATEX(ALL('InterfaceHTML'), MID('InterfaceHTML'[conteudo], 2, LEN('InterfaceHTML'[conteudo])-2), "", 'InterfaceHTML'[ordem], ASC)
			RETURN SUBSTITUTE(__Html, "__NARUTO_DATA__", SUBSTITUTE(__Dataset, "<", "\u003c"))
		displayFolder: Interface HTML
		lineageTag: e333c6cf-d48a-5520-8e18-9fb422920965

	column versao
		dataType: string
		isHidden
		lineageTag: 65da5ba6-dc6f-5f6f-ac67-532040ac4241
		summarizeBy: none
		sourceColumn: versao

	partition Indicadores = m
		mode: import
		source =
				let
				    Dados = Json.Document(Binary.Decompress(Binary.FromText("H4sIAAAAAAACCouuVipLLSpOzFeyUjLUM1CqjQUAbb8HThIAAAA=", BinaryEncoding.Base64), Compression.GZip)),
				    Fonte = Table.FromRecords(Dados),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"versao", type text}}, "en-US")
				in
				    Tipos

